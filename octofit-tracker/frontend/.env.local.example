# GitHub Codespaces Configuration
# REQUIRED when running in GitHub Codespaces.
# Replace 'your-codespace-name' with your actual Codespace name.
# Example: VITE_CODESPACE_NAME=yellow-space-robot-abc123
#
# When set, API requests route to: https://{VITE_CODESPACE_NAME}-8000.app.github.dev/api/
# When unset, API requests route to: http://localhost:8000/api/
#
# Instructions:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Replace 'your-codespace-name' with your actual Codespace name
# 3. Commit .env.local to .gitignore (it's environment-specific)

VITE_CODESPACE_NAME=your-codespace-name
